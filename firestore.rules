rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /devices/{id} {
      allow get: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /blocks/{id} {
      allow read: if signedIn() && resource.data.from == request.auth.uid;
      allow read: if signedIn() && resource.data.to == request.auth.uid;
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    match /chats/{chatId} {
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.type == resource.data.type
        && (resource.data.type != 'dm' || request.resource.data.members == resource.data.members);

      match /messages/{mid} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        function member() { return signedIn() && request.auth.uid in chat().members; }
        function other() {
          return chat().members[0] == request.auth.uid ? chat().members[1] : chat().members[0];
        }
        function notBlocked() {
          return chat().type != 'dm'
            || !exists(/databases/$(database)/documents/blocks/$(other() + '_' + request.auth.uid));
        }

        allow read: if member();
        allow create: if member() && notBlocked()
          && request.resource.data.get('from', request.resource.data.get('actor', '')) == request.auth.uid;
        allow update: if member()
          && resource.data.get('from', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited']);
        allow delete: if member()
          && (resource.data.get('from', '') == request.auth.uid
              || chat().get('owner', '') == request.auth.uid
              || chat().type == 'dm');
      }
    }

    match /calls/{callId} {
      allow get: if signedIn() && (resource == null
        || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list: if signedIn() && resource.data.to == request.auth.uid;
      allow list: if signedIn() && resource.data.from == request.auth.uid;
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow delete: if signedIn() && resource.data.from == request.auth.uid;

      match /ice/{iceId} {
        function call() { return get(/databases/$(database)/documents/calls/$(callId)).data; }
        allow read, create: if signedIn()
          && (call().from == request.auth.uid || call().to == request.auth.uid);
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }
    }
  }
}
